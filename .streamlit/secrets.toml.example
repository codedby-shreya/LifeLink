# Copy to .streamlit/secrets.toml for local use (git-ignored), or paste the same keys into
# Streamlit Community Cloud → App → Settings → Secrets. NEVER commit real values.

GEMINI_API_KEY = "your_google_gemini_api_key_here"

# Supabase Postgres connection for the least-privilege `lifelink_app` role (see README).
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL = "postgresql://lifelink_app.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres"

# Administrator password hash — create with:  python scripts/hash_password.py
ADMIN_PASSWORD_HASH = "pbkdf2_sha256$200000$<salt>$<digest>"
