# Copy this file to .env for LOCAL development. Never commit .env.

# --- AI assistant (Google Gemini) ---
GEMINI_API_KEY=your_google_gemini_api_key_here

# --- Database ---
# Leave DATABASE_URL empty to use a local SQLite file (data/lifelink.db).
# For Supabase, use the *app role* connection string (see README):
# DATABASE_URL=postgresql://lifelink_app.<project-ref>:<url-encoded-password>@<pooler-host>:5432/postgres

# --- Administrator login ---
# Generate with:  python scripts/hash_password.py
# ADMIN_PASSWORD_HASH='Lawanya-jha-77-sssss'
